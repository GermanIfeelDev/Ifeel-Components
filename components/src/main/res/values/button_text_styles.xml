<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- region Base Button Style -->
    <style name="TextStyle.Button">
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <!-- endregion -->

    <!-- region Button Large Styles -->
    <style name="TextStyle.Button.Large">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextStyle.Button.Large.SemiBold">
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <!-- endregion -->

    <!-- region Button Default Styles -->
    <style name="TextStyle.Button.Default">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextStyle.Button.Default.SemiBold">
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="TextStyle.Button.Default.Regular">
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <!-- endregion -->

    <!-- region Button Small Styles -->
    <style name="TextStyle.Button.Small">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextStyle.Button.Small.SemiBold">
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <!-- endregion -->
</resources>
