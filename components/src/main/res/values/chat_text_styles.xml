<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- region Base Chat Style -->
    <style name="TextStyle.Chat">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">8sp</item>
        <item name="android:textColor">@color/color_text_600</item>
    </style>
    <!-- endregion -->

    <!-- region Chat SemiBold -->
    <style name="TextStyle.Chat.SemiBold">
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <!-- endregion -->

    <!-- region Chat Regular -->
    <style name="TextStyle.Chat.Regular">
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <!-- endregion -->
</resources>
