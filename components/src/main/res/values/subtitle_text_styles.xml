<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- region Base Subtitle Style -->
    <style name="TextStyle.Subtitle">
        <item name="android:textColor">@color/color_text_600</item>
    </style>
    <!-- endregion -->

    <!-- region Subtitle Semibold -->
    <style name="TextStyle.Subtitle.Semibold">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <!-- endregion -->

    <!-- region Subtitle Regular -->
    <style name="TextStyle.Subtitle.Regular">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <!-- endregion -->

    <!-- region Subtitle Semibold Secondary -->
    <style name="TextStyle.Subtitle.SemiboldSecondary">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/lora_semibold</item>
    </style>
    <!-- endregion -->

    <!-- region Subtitle Medium Secondary -->
    <style name="TextStyle.Subtitle.MediumSecondary">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/lora_medium</item>
    </style>
    <!-- endregion -->
</resources>
