<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Normal style fonts -->
    <font
        app:font="@font/poppins_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

    <font
        app:font="@font/poppins_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        app:font="@font/poppins_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        app:font="@font/poppins_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        app:font="@font/poppins_light"
        app:fontStyle="normal"
        app:fontWeight="300" />

    <!-- Italic style fonts -->
    <font
        app:font="@font/poppins_bold_italic"
        app:fontStyle="italic"
        app:fontWeight="700" />

    <font
        app:font="@font/poppins_semibold_italic"
        app:fontStyle="italic"
        app:fontWeight="600" />

    <font
        app:font="@font/poppins_medium_italic"
        app:fontStyle="italic"
        app:fontWeight="500" />

    <font
        app:font="@font/poppins_regular_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />

    <font
        app:font="@font/poppins_light_italic"
        app:fontStyle="italic"
        app:fontWeight="300" />
</font-family>

